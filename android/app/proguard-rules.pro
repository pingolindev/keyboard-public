# The engine bindings (generated by UniFFI) are called through JNA reflection.
-keep class com.pingolin.keyboard.engine.** { *; }

# JNA
-keep class com.sun.jna.** { *; }
-keepclassmembers class * extends com.sun.jna.** { public *; }
# JNA refers to java.awt for desktop use, which Android does not have.
-dontwarn java.awt.**
